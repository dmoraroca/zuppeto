<Project>
  <PropertyGroup>
    <!-- Host F5 uses obj-local/bin-local next to each project. -->
    <!-- Docker sets ZUPPETO_BUILD_ROOT=/tmp/... so builds never touch the bind-mounted tree. -->
    <_ZuppetoBuildRoot Condition="'$(ZUPPETO_BUILD_ROOT)' != ''">$(ZUPPETO_BUILD_ROOT)/$(MSBuildProjectName)</_ZuppetoBuildRoot>
    <BaseIntermediateOutputPath Condition="'$(_ZuppetoBuildRoot)' != ''">$(_ZuppetoBuildRoot)/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath Condition="'$(_ZuppetoBuildRoot)' != ''">$(_ZuppetoBuildRoot)/obj/</MSBuildProjectExtensionsPath>
    <BaseOutputPath Condition="'$(_ZuppetoBuildRoot)' != ''">$(_ZuppetoBuildRoot)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(_ZuppetoBuildRoot)' == ''">obj-local/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath Condition="'$(_ZuppetoBuildRoot)' == ''">obj-local/</MSBuildProjectExtensionsPath>
    <BaseOutputPath Condition="'$(_ZuppetoBuildRoot)' == ''">bin-local/</BaseOutputPath>
    <!-- En alguns filesystems del host, MSBuild 18 pot fallar silenciosament
         mentre avalua projectes en paral·lel (0 errors, exit code 1). -->
    <BuildInParallel Condition="'$(_ZuppetoBuildRoot)' == ''">false</BuildInParallel>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**;**/obj-local/**;**/bin-local/**</DefaultItemExcludes>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
</Project>
