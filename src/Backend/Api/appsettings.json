{
  "ConnectionStrings": {
    "Zuppeto": "Host=localhost;Port=5433;Database=zuppeto;Username=app;Password=app"
  },
  "OpenStreetMap": {
    "Overpass": {
      "BaseUrl": "https://overpass-api.de/api/interpreter",
      "TimeoutSeconds": 30,
      "MaximumRetries": 2,
      "BackoffMilliseconds": 750,
      "MaximumItems": 250
    },
    "GeofabrikExtract": {
      "SourceUrl": "https://download.geofabrik.de/europe/spain/cataluna-latest.osm.pbf",
      "ExtractPath": "",
      "SourceVersion": "",
      "MaximumItems": 0,
      "ReusableIndexEnabled": true,
      "IndexDirectory": "/tmp/petiloc-osm-index"
    },
    "DirectMap": {
      "Enabled": false,
      "BaseUrl": "https://api.openstreetmap.org/api/0.6/",
      "TimeoutSeconds": 45,
      "MaximumBoundingBoxArea": 0.01,
      "MaximumDownloadBytes": 25000000,
      "TerritorialUnitId": "8680aa5a-292f-4201-8d52-d6381f438af4",
      "OfficialCode": "08006",
      "West": 2.521202,
      "South": 41.5694737,
      "East": 2.5720886,
      "North": 41.5956628
    }
  },
  "Auth": {
    "FrontendBaseUrl": "http://localhost:4200",
    "Jwt": {
      "Issuer": "Zuppeto",
      "Audience": "Zuppeto.Web",
      "SigningKey": "dev-only-zuppeto-signing-key-change-in-production-123456789",
      "ExpiresInMinutes": 480
    },
    "Google": {
      "ClientId": "",
      "AdminEmails": []
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": "",
      "RedirectUri": "http://localhost:5211/api/auth/facebook/callback",
      "AdminEmails": []
    }
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "AccountActivation": {
    "DeliveryMode": "Smtp",
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "GooglePlaces": {
    "Enabled": false,
    "BaseUrl": "https://maps.googleapis.com/maps/api/place/",
    "ApiKey": "",
    "UseNewApi": false,
    "TimeoutSeconds": 6,
    "CoordinateCacheRetentionDays": 30,
    "MaxBackgroundEnrichmentsPerPage": 3,
    "MaxPhotoDownloadsPerPlace": 2,
    "MaxNewPlacesPerSearch": 3
  },
  "PlaceSources": {
    "OvertureMaps": {
      "Enabled": false,
      "ReleaseVersion": "2026-09-23.1",
      "ExtractPath": "",
      "BoundaryGeoJsonPath": "",
      "RequireVerifiedBoundary": true
    },
    "DibaMunicipalEstablishments": {
      "Enabled": false,
      "BaseUrl": "https://do.diba.cat/api/",
      "TimeoutSeconds": 30
    },
    "Wikidata": {
      "Enabled": true,
      "BaseUrl": "https://www.wikidata.org/wiki/Special:EntityData/",
      "TimeoutSeconds": 15
    }
  },
  "Mapillary": {
    "Enabled": false,
    "BaseUrl": "https://graph.mapillary.com/",
    "TimeoutSeconds": 15
  },
  "GooglePlacesCompliance": {
    "Enabled": false,
    "RunIntervalMinutes": 360
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
