{
  "name": "zuppeto-e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "e2e": "npm run e2e:chrome",
    "e2e:install": "playwright install --with-deps",
    "runner:build": "tsc --project tsconfig.runner.json",
    "runner:test": "npm run runner:build && node --test .runner-build/tests/runner/**/*.test.js",
    "runner:simulate": "npm run runner:build && node .runner-build/runner/cli.js simulate",
    "runner:resume": "npm run runner:build && node .runner-build/runner/cli.js resume",
    "ci:accounts": "npm run runner:build && node .runner-build/runner/ci-accounts-cli.js",
    "ci:consolidate": "npm run runner:build && node .runner-build/runner/ci-consolidate-cli.js",
    "ci:artifacts:audit": "npm run runner:build && node .runner-build/runner/ci-artifact-audit-cli.js",
    "excel:migrate": "npm run runner:build && node .runner-build/runner/excel-migrate-cli.js",
    "chrome:inventory": "npm run runner:build && node .runner-build/runner/chrome-inventory-cli.js",
    "chrome:accounts": "npm run runner:build && node .runner-build/runner/chrome-account-provision-cli.js",
    "e2e:chrome": "npm run runner:build && node .runner-build/runner/chrome-cli.js",
    "e2e:chrome:resume": "npm run runner:build && node .runner-build/runner/chrome-cli.js --resume",
    "e2e:firefox": "npm run runner:build && node .runner-build/runner/firefox-cli.js",
    "e2e:firefox:resume": "npm run runner:build && node .runner-build/runner/firefox-cli.js --resume",
    "webkit:inventory": "npm run runner:build && node .runner-build/runner/webkit-inventory-cli.js",
    "e2e:webkit": "npm run runner:build && node .runner-build/runner/webkit-cli.js",
    "e2e:webkit:resume": "npm run runner:build && node .runner-build/runner/webkit-cli.js --resume",
    "e2e:edge": "npm run runner:build && node .runner-build/runner/edge-cli.js",
    "e2e:edge:resume": "npm run runner:build && node .runner-build/runner/edge-cli.js --resume",
    "e2e:pilot": "npm run runner:build && node .runner-build/runner/pilot-cli.js",
    "e2e:pilot:resume": "npm run runner:build && node .runner-build/runner/pilot-cli.js --resume",
    "e2e:activation": "npm run runner:build && node .runner-build/runner/activation-email-cli.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "22.20.2",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  }
}
